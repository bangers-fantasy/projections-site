# Response headers for the whole site. Cloudflare consumes this file and does not serve it.
# Hand-written like wrangler.toml and .assetsignore; build_static.py only sweeps stale *.html,
# so it survives a rebuild.
#
# WHY THIS EXISTS. The site had no security headers at all. It is static, it loads nothing
# from a third party and it reflects no user input, so the odds of an injection are already
# low. What raises the stakes is that a buyer's season password lives in localStorage: any
# script that ever runs on this origin can read it and post it somewhere. Most of the value
# below is in the outbound half of the CSP, which is what turns "an injection happened" into
# "an injection happened and could not phone home".
#
# 'unsafe-inline' is unavoidable for now: every page carries inline <style>, inline <script>
# and onclick handlers, all generated by app.py. Hashes or a nonce would be the stronger
# answer and would mean changing how PAGE is assembled. Even with it, default-src/connect-src
# 'self' still blocks loading or reaching ANY other origin.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=15552000; includeSubDomains

# The paid payload. Fingerprinted in every page's fetch URL (?v=<sha256[:12]>) and read with
# cache: "force-cache", so it is safe to cache hard; a new build changes the URL.
/locked/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex
